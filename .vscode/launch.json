{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Cucumber (ENV + Tags)",
      "type": "node",
      "request": "launch",

      "program": "${workspaceFolder}/node_modules/@cucumber/cucumber/bin/cucumber.js",

      "runtimeArgs": [
        "-r",
        "ts-node/register"
      ],

      "args": [
        "--tags",
        "@Checkout"
      ],

      "env": {
        "ENV": "uat"
      },

      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}